{
  "productName": "过程SPC监控平台",
  "version": "1.7.4",
  "identifier": "com.ft1.monitor",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["ft1-backend/"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "液奶过程监控系统",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "widget",
        "title": "SPC 看板",
        "url": "widget.html",
        "width": 420,
        "height": 620,
        "visible": false,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://tauri.localhost asset: https://asset.localhost; script-src 'self' https://tauri.localhost asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: https://asset.localhost; frame-src 'self' https://tauri.localhost asset: https://asset.localhost; connect-src 'self' http://127.0.0.1:18080 http://localhost:18080 ws://127.0.0.1:18080 ws://localhost:18080 http://106.13.77.213:9090"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://106.13.77.213:9090/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMkY4OTRDMjNBMkM0QUMKUldTc3hLSWpUSWt2bXNxTHNBUDIwczRWOThjclhJcG9SdHM4eW5DRVE2WW1CZFMxNlRldGJ5K2oK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
